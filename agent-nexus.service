[Unit]
Description=Agent Nexus Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Projects/agent-nexus_AONA_master/agent-nexus
EnvironmentFile=-/home/ubuntu/Projects/agent-nexus_AONA_master/agent-nexus/.env
ExecStart=/home/ubuntu/Projects/agent-nexus_AONA_master/agent-nexus/.venv/bin/python -m uvicorn src.server.app:app --host 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
