[Unit]
Description=Virtual Human Agent Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/Projects/virtual-human-sdk-feature-aionui
ExecStart=/home/ubuntu/.local/bin/uv run python -m uvicorn src.server.app:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# 日志限制
SystemMaxUse=100M
SystemMaxFileSize=10M
SystemMaxFiles=10
MaxRetentionSec=7d

[Install]
WantedBy=multi-user.target
