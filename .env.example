# =============================================================================
# Agent Nexus Configuration
# =============================================================================
# 复制此文件为 .env 并根据需要修改配置
# Copy this file to .env and modify as needed
# =============================================================================

# -----------------------------------------------------------------------------
# Server Settings | 服务器配置
# -----------------------------------------------------------------------------

# API 监听地址 | API host address
API_HOST=0.0.0.0

# API 端口 | API port
API_PORT=8081

# Worker 进程数 | Number of worker processes
API_WORKERS=1

# 运行环境 | Environment (development/staging/production)
ENVIRONMENT=development

# 调试模式 | Debug mode
DEBUG=false

# -----------------------------------------------------------------------------
# Logging Settings | 日志配置
# -----------------------------------------------------------------------------

# 日志级别 | Log level (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# 日志目录 | Log directory
LOG_DIR=./logs

# 单个日志文件最大大小（字节） | Max log file size in bytes
LOG_MAX_BYTES=10485760

# 日志备份数量 | Number of log backups
LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# User Directory Settings | 用户目录配置
# -----------------------------------------------------------------------------

# 用户目录根路径 | Base path for user home directories
USER_HOME_BASE=/home

# 是否自动创建用户目录 | Auto create user directory
AUTO_CREATE_USER_DIR=true

# 默认执行用户 | Default exec user
EXEC_USER=ubuntu

# -----------------------------------------------------------------------------
# Redis Settings | Redis 配置
# -----------------------------------------------------------------------------

# Redis 主机地址 | Redis host
REDIS_HOST=localhost

# Redis 端口 | Redis port
REDIS_PORT=6379

# Redis 数据库编号 | Redis database number
REDIS_DB=0

# Redis 密码（如不需要认证则留空） | Redis password (leave empty if no auth)
REDIS_PASSWORD=

# Redis Key 前缀 | Redis key prefix
REDIS_KEY_PREFIX=aona:

# Redis 连接超时（秒） | Redis connection timeout in seconds
REDIS_CONNECTION_TIMEOUT=10

# Redis Socket 超时（秒） | Redis socket timeout in seconds
REDIS_SOCKET_TIMEOUT=5

# -----------------------------------------------------------------------------
# Streaming Settings | 流式输出配置
# -----------------------------------------------------------------------------

# 每次发送的字符数 | Characters per chunk
STREAM_CHUNK_SIZE=100

# 发送间隔（毫秒） | Delay between chunks in milliseconds
STREAM_DELAY_MS=50

# 缓冲区大小 | Buffer size
STREAM_BUFFER_SIZE=1000

# -----------------------------------------------------------------------------
# Task Executor Settings | 任务执行器配置
# -----------------------------------------------------------------------------

# 是否启用执行器 | Enable executor
EXECUTOR_ENABLED=true

# 默认最大并发数 | Default max concurrency
EXECUTOR_DEFAULT_MAX_CONCURRENCY=3

# 轮询间隔（秒） | Poll interval in seconds
EXECUTOR_POLL_INTERVAL=1.0

# 最大重试次数 | Max retries
EXECUTOR_MAX_RETRIES=3

# 重试延迟（秒） | Retry delay in seconds
EXECUTOR_RETRY_DELAY=5.0

# 任务超时（秒） | Task timeout in seconds
EXECUTOR_TASK_TIMEOUT=3600.0

# -----------------------------------------------------------------------------
# Provider Settings | Provider 配置
# -----------------------------------------------------------------------------

# CLI 执行命令（默认 Provider）| CLI executor command
# (旧名 CCR_COMMAND 仍可使用，向后兼容)
CLI_COMMAND=codebuddy

# CLI 执行超时（秒） | CLI executor timeout in seconds
# (旧名 CCR_TIMEOUT 仍可使用，向后兼容)
CLI_TIMEOUT=600

# Gemini CLI 命令 | Gemini CLI command
GEMINI_COMMAND=gemini

# Agent -> CLI 命令映射（JSON 格式）
# Agent to CLI command mapping (JSON format)
# (旧名 AGENT_CCR_COMMAND_MAP 仍可使用，向后兼容)
# Example: {"agent1": "claude", "agent2": "codebuddy"}
# AGENT_CLI_COMMAND_MAP={}

# 默认 Provider（创建任务时未指定时使用，只接受真实 provider）
# Default provider when not specified in task creation
# Valid values: claude, gemini, codex, codebuddy
DEFAULT_PROVIDER=codebuddy

# 默认 Alias（创建任务时未指定 alias 时使用，可以是 alias 或 provider）
# Default alias when not specified in task creation
# Examples: claude-internal, gemini-internal, codex-internal, codebuddy
DEFAULT_ALIAS=

# 默认 Exec User（创建任务时未指定时使用）
# Default exec user when not specified in task creation
DEFAULT_EXEC_USER=

# -----------------------------------------------------------------------------
# Nexus UI Settings | Nexus 控制台配置
# -----------------------------------------------------------------------------

# Nexus 登录密码（设置后需要输入密码才能访问）
# Nexus login password (when set, password is required to access)
# Leave empty to disable authentication
NEXUS_PASSWORD=

# Nexus Session 有效期（秒）| Session validity in seconds
NEXUS_SESSION_TTL=86400

# -----------------------------------------------------------------------------
# Channels Settings | 消息渠道配置
# -----------------------------------------------------------------------------

# 是否启用消息渠道服务 | Enable channel service
CHANNELS_ENABLED=true

# --- Telegram ---
# Telegram Bot Token（从 @BotFather 获取）
# Get from @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# 允许的 Telegram 用户 ID（逗号分隔，留空则允许所有用户）
# Allowed user IDs (comma-separated, empty allows all)
TELEGRAM_ALLOWED_USERS=

# --- Slack ---
# Slack Bot OAuth Token（以 xoxb- 开头）
# Slack Bot OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=

# Slack App Token（Socket Mode，以 xapp- 开头）
# Slack App Token for Socket Mode (starts with xapp-)
SLACK_APP_TOKEN=

# --- Discord ---
# Discord Bot Token
# Get from Discord Developer Portal: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# --- 飞书 (Feishu/Lark) ---
# 飞书应用 App ID | Feishu App ID
# 从飞书开放平台获取: https://open.feishu.cn/app
FEISHU_APP_ID=

# 飞书应用 App Secret | Feishu App Secret
FEISHU_APP_SECRET=

# 飞书事件订阅验证 Token (可选) | Verification token for event subscription
FEISHU_VERIFICATION_TOKEN=

# 飞书事件加密密钥 (可选) | Encrypt key for event encryption
FEISHU_ENCRYPT_KEY=

# --- WhatsApp (via WhatsApp Business API / Cloud API) ---
# WhatsApp Business API Token
WHATSAPP_API_TOKEN=

# WhatsApp 手机号 ID | WhatsApp Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Webhook 验证 Token | Webhook verify token
WHATSAPP_VERIFY_TOKEN=

# --- Signal (via signal-cli REST API) ---
# Signal CLI REST API 地址 | Signal CLI REST API URL
SIGNAL_API_URL=http://localhost:8080

# Signal 发送方号码（E.164 格式，如 +1234567890）
# Signal sender number in E.164 format
SIGNAL_PHONE_NUMBER=

# --- 企业微信智能机器人 (WeCom AI Bot) ---
# API 模式选择：webhook（默认，短连接）| websocket（长连接）
# API mode: webhook (default, short connection) | websocket (long connection)
WECOM_MODE=webhook

# ---- Webhook 模式配置 ----
# 企微智能机器人回调配置的 Token（Webhook 模式必填）
# WeCom AI Bot callback Token (required for webhook mode)
WECOM_TOKEN=

# 企微智能机器人回调配置的 EncodingAESKey（43 字符，Webhook 模式必填）
# WeCom AI Bot callback EncodingAESKey (43 chars, required for webhook mode)
WECOM_ENCODING_AES_KEY=

# 企微智能机器人 ID（可选，用于过滤消息）
# WeCom AI Bot ID (optional, for message filtering)
WECOM_AIBOT_ID=

# ---- WebSocket 长连接模式配置 ----
# 智能机器人 BotID（WebSocket 模式必填，从企微管理后台获取）
# Bot ID (required for websocket mode, get from WeCom admin console)
WECOM_AI_BOT_ID=

# 长连接专用 Secret（WebSocket 模式必填，从企微管理后台获取）
# WebSocket Secret (required for websocket mode, get from WeCom admin console)
WECOM_SECRET=

# WebSocket 连接地址（一般无需修改）
# WebSocket URL (usually no need to change)
# WECOM_WS_URL=wss://openws.work.weixin.qq.com

# 心跳间隔（秒，默认 30）| Heartbeat interval in seconds (default 30)
# WECOM_HEARTBEAT_INTERVAL=30

# 最大重连次数（默认 20）| Max reconnect attempts (default 20)
# WECOM_RECONNECT_MAX_ATTEMPTS=20

# WS 流式更新间隔毫秒（默认 500）| WS stream update interval in ms (default 500)
# WECOM_WS_STREAM_INTERVAL_MS=500

# --- 企业微信普通机器人 (WeCom Bot) ---
# 企微普通机器人回调配置的 Token（必填）
# WeCom Bot callback Token (required)
WECOM_BOT_TOKEN=

# 企微普通机器人回调配置的 EncodingAESKey（43 字符，必填）
# WeCom Bot callback EncodingAESKey (43 chars, required)
WECOM_BOT_ENCODING_AES_KEY=

# 企微普通机器人 Webhook Key（必填，从 Webhook URL 中的 key= 参数提取）
# WeCom Bot Webhook Key (required, extract from webhook URL key= param)
WECOM_BOT_WEBHOOK_KEY=

# 流式模拟每次发送字符数（群聊生效，默认 50）
# Stream simulation chunk size (group chat only, default 50)
WECOM_BOT_STREAM_CHUNK_SIZE=50

# 流式模拟发送间隔毫秒（群聊生效，默认 200，实际至少 3000ms）
# Stream simulation interval in ms (group chat only, default 200, min 3000ms)
WECOM_BOT_STREAM_INTERVAL_MS=200

# 企微普通机器人专用 CLI 超时（秒，默认 1800）
# Dedicated CLI timeout for WeCom Bot conversations in seconds (default 1800)
WECOM_BOT_CLI_TIMEOUT=1800

# --- 微信个人号 (WeChat Personal via iLink Bot API) ---
# WeChat Bot Token（通过 'anexus login wechat' 扫码获取）
# Get by running: anexus login wechat
WECHAT_BOT_TOKEN=

# WeChat API Base URL（一般无需修改）
# WeChat API Base URL (usually no need to change)
# WECHAT_BASE_URL=https://ilinkai.weixin.qq.com

# Long-poll 超时毫秒（默认 35000）| Long-poll timeout in ms (default 35000)
# WECHAT_POLL_TIMEOUT_MS=35000

# 普通 API 请求超时毫秒（默认 15000）| API timeout in ms (default 15000)
# WECHAT_API_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Channel-level Provider Overrides | 渠道级 Provider 覆盖配置
# -----------------------------------------------------------------------------
# 为单个渠道指定 provider/alias/exec_user，优先级高于全局 DEFAULT_PROVIDER，
# 但低于用户在会话中使用 /switch 命令的设置。
# Per-channel provider/alias/exec_user overrides. Takes priority over global
# DEFAULT_PROVIDER but is overridden by session-level /switch commands.
#
# 格式 | Format: <CHANNEL>_PROVIDER / <CHANNEL>_ALIAS / <CHANNEL>_EXEC_USER
#
# 示例 | Example: 让企微普通机器人默认使用 claude provider
# WECOM_BOT_PROVIDER=claude
# WECOM_BOT_ALIAS=claude-internal
# WECOM_BOT_EXEC_USER=tswitch
#
# 支持的渠道 | Supported channels:
#   TELEGRAM, SLACK, DISCORD, FEISHU, WECOM, WECOM_BOT
#
# TELEGRAM_PROVIDER=
# TELEGRAM_ALIAS=
# TELEGRAM_EXEC_USER=
# SLACK_PROVIDER=
# SLACK_ALIAS=
# SLACK_EXEC_USER=
# DISCORD_PROVIDER=
# DISCORD_ALIAS=
# DISCORD_EXEC_USER=
# FEISHU_PROVIDER=
# FEISHU_ALIAS=
# FEISHU_EXEC_USER=
# WECOM_PROVIDER=
# WECOM_ALIAS=
# WECOM_EXEC_USER=
# WECOM_BOT_PROVIDER=
# WECOM_BOT_ALIAS=
# WECOM_BOT_EXEC_USER=
# WECHAT_PROVIDER=
# WECHAT_ALIAS=
# WECHAT_EXEC_USER=

# =============================================================================
# Notes | 说明
# =============================================================================
#
# 1. 所有配置项都有默认值，只需配置需要修改的项目
#    All settings have defaults; only configure what you need to change
#
# 2. Channels 依赖需要单独安装：
#    Channel dependencies need to be installed separately:
#    - Telegram: pip install -e ".[telegram]"
#    - Slack:    pip install -e ".[slack]"
#    - Discord:  pip install -e ".[discord]"
#    - All:      pip install -e ".[all-channels]"
#
# 3. 使用 uv 安装依赖：
#    Using uv to install dependencies:
#    - uv sync
#    - uv pip install -e ".[telegram]"
#
# 4. 启动服务：
#    Start service:
#    - ./scripts/run.sh
#    - 或 uvicorn src.server.app:app --host 0.0.0.0 --port 8081
#
# =============================================================================
